<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gün Aşırı İlaç Asistanı"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etIlac1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="1. Gün İlacı (Örn: Tansiyon ilacı)"
        android:inputType="textCapSentences"
        android:padding="14dp"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/etIlac2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="2. Gün İlacı (Örn: Kan sulandırıcı)"
        android:inputType="textCapSentences"
        android:padding="14dp"
        android:layout_marginBottom="10dp" />

    <TimePicker
        android:id="@+id/timePicker"
        android:layout_width="wrap_content"
        android:layout_height="150dp"
        android:timePickerMode="spinner"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnKaydet"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Dönüşümlü Hatırlatıcıyı Kur"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnTestSes"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:text="Sesi Şimdi Test Et" />

    <TextView
        android:id="@+id/tvDurum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Henüz aktif bir hatırlatıcı yok."
        android:textAlignment="center"
        android:textSize="15sp" />

</LinearLayout>